# Base URL of the backend API (include /api)
VITE_API_URL=http://localhost:5000/api

# Stripe publishable key (safe to expose client-side). Leave blank to hide
# the "Pay with card" option and default to Cash on Delivery only.
VITE_STRIPE_PUBLISHABLE_KEY=

# Cashfree client id (safe to expose client-side, mirrors the backend's
# CASHFREE_CLIENT_ID). This is only used to decide whether to show the
# Cashfree option at checkout - leave blank to hide it.
VITE_CASHFREE_CLIENT_ID= TEST11216900b93b1bf50a80ab5823da00961211