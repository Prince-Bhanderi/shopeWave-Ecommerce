# ==============================
# Server
# ==============================
NODE_ENV=development
PORT=5000

# ==============================
# Database
# ==============================
# Local MongoDB example: mongodb://127.0.0.1:27017/ecommerce
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/ecommerce
MONGO_URI="mongodb+srv://iamprince8182_db_user:UU9yqfE8oS8ktova@cluster0.c8dgpvb.mongodb.net/ecommerce?retryWrites=true&w=majority&appName=Cluster0"

# ==============================
# Authentication
# ==============================
JWT_SECRET=myTempSecretKey12345ChangeThisLater
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# ==============================
# Client
# ==============================
CLIENT_URL=http://localhost:5173

# ==============================
# Stripe (leave blank to disable card payments, COD still works)
# ==============================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==============================
# Cashfree (leave blank to disable Cashfree, COD/Stripe still work)
# Get sandbox (test) credentials from
# https://merchant.cashfree.com/merchants/pg/credentials after creating a
# free Cashfree account. Charges are made in INR - see the comment above
# CASHFREE_CURRENCY in paymentController.js if you need a different currency.
# CASHFREE_ENV is SANDBOX (test mode) or PRODUCTION (live) - leave as
# SANDBOX until you're actually ready to accept real payments.
# ==============================
CASHFREE_CLIENT_ID="TEST11216900b93b1bf50a80ab5823da00961211"
CASHFREE_ENV=SANDBOX

# ==============================
# Cloudinary (leave blank to fall back to local /uploads storage)
# ==============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================
# Email (used for password reset emails - optional in dev,
# reset link is logged to the console when SMTP is not configured)
# ==============================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@shopwave.dev

# ==============================
# Seed / Admin bootstrap (used only by the seed script)
# ==============================
ADMIN_EMAIL=admin@shopwave.dev
ADMIN_PASSWORD=Admin@12345
